# Server-side only. Never put real values in this example or frontend files.
# Shared/free CloudBase: omit DATABASE_URL; use HTTPS and the server-only API Key.
CLOUDBASE_ENV_ID=YOUR-ENV-ID
CLOUDBASE_API_KEY=YOUR-SERVER-ONLY-ADMIN-API-KEY
# Dedicated/native PostgreSQL only (optional):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
PUBLIC_ORIGIN=https://YOUR-APP-DOMAIN
FAMILY_USERNAME=YOUR-FAMILY-NAME
FAMILY_PASSWORD=CHANGE-THIS-TO-A-UNIQUE-LONG-PASSWORD
PORT=9000
# Optional if the platform supplies a private certificate authority:
# PGSSLROOTCERT=/path/to/provider-ca.pem
